{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "abandonments:recommended",
    "github>home-operations/renovate-presets#11.0.0",
  ],
  labels: ["dependencies"],
  // The Renovate operator watches this checkbox to trigger a repository run.
  dependencyDashboardFooter: "- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository",
  packageRules: [
    {
      // Override inherited automerge rules until this repository has required CI checks.
      matchPackageNames: ["*"],
      automerge: false,
      semanticCommitType: "chore",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "ci",
    },
  ],
}
